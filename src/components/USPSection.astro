---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl } from '~/i18n/utils';
import { usps as uspsByLang } from '~/i18n/content';

const usps = uspsByLang[getLangFromUrl(Astro.url)];

const { id, isDark = false, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {
      usps.map(({ title, description, icon }) => (
        <div class="flex flex-col items-center text-center p-6 rounded-lg border border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md transition-shadow duration-300 intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <div class="flex items-center justify-center w-12 h-12 mb-4 rounded-full bg-primary/10 text-primary">
            <Icon name={icon} class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-bold mb-2 dark:text-white">{title}</h3>
          <p class="text-sm text-muted dark:text-slate-400">{description}</p>
        </div>
      ))
    }
  </div>
</WidgetWrapper>
