---
import logoImage from '~/assets/images/logo.png';
import heroImage from '~/assets/images/hero.png';

import { SITE } from '~/config';
import { getLangFromUrl, getRoute, useTranslations } from '~/i18n/utils';
import { businessOffers } from '~/i18n/content';

/**
 * The single source of LocalBusiness data for the whole site.
 *
 * Keep it here and nowhere else -- two competing LocalBusiness blocks used to
 * be emitted on every page with conflicting priceRange and image values, which
 * left it to the search engine to guess which one was authoritative.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/** Build an absolute URL; JSON-LD must not contain site-relative paths. */
const absolute = (pathOrUrl: string) => new URL(pathOrUrl, SITE.site).href;

const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('breadcrumb.home'),
      item: absolute(getRoute('home', lang)),
    },
  ],
};

const localBusinessData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.site.replace(/\/$/, '')}/#localbusiness`,
  name: 'Chuẩn Màu',
  alternateName: t('business.alternateName'),
  description: t('business.description'),
  url: absolute(getRoute('home', lang)),
  telephone: '+84879025858',
  priceRange: '150.000₫ – 200.000₫',
  // Imported so the hashed asset URL stays correct; this used to be a
  // hand-written /_astro/ hash and a /og-image.jpg that did not exist.
  image: absolute(heroImage.src),
  logo: absolute(logoImage.src),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Số 9 Duy Tân',
    addressLocality: 'Cầu Giấy',
    addressRegion: 'Hà Nội',
    postalCode: '100000',
    addressCountry: 'VN',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 21.0299957,
    longitude: 105.7841586,
  },
  // These hours belong to the Cầu Giấy address above. The second branch
  // (Phú Thượng, 18:00-22:00) is a separate location and needs its own
  // LocalBusiness entity on its own page rather than extra hours here.
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:00',
      closes: '18:00',
    },
  ],
  areaServed: {
    '@type': 'City',
    name: t('business.areaServed'),
  },
  sameAs: ['https://www.facebook.com/chuanmaucom', 'https://zalo.me/0879025858'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: t('business.catalogName'),
    itemListElement: businessOffers[lang].map((offer) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: offer.name,
        description: offer.description,
      },
      price: offer.price,
      priceCurrency: 'VND',
    })),
  },
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessData)} />
